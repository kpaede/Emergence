{
  "name": "emergence",
  "version": "0.1.0",
  "description": "Lokaler Multiplex-Wissensgraph und kontrollierte KI-Vorschläge für Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:vault": "node scripts/inspect-vault.mjs",
    "source:export": "node scripts/export-source.mjs",
    "test:obsidian": "node scripts/obsidian-check.mjs",
    "test:ollama": "EMERGENCE_OLLAMA_TEST=1 vitest run tests/ollama.integration.test.ts",
    "test:ux": "node scripts/ux-check.mjs",
    "test:context": "node scripts/context-check.mjs",
    "test:assignment-ui": "node scripts/assignment-ui-check.mjs",
    "test:analysis-interactions": "node scripts/analysis-interaction-check.mjs",
    "test:models": "node scripts/compare-models.mjs",
    "test:one-click": "node scripts/one-click-native-check.mjs",
    "test:ideas-ui": "node scripts/compact-ideas-ui-check.mjs",
    "test:ideas": "node scripts/association-comparison.mjs",
    "test:zotlit": "node scripts/zotlit-native-check.mjs",
    "test:inline-edit": "node scripts/inline-edit-native-check.mjs",
    "test:target-matches": "node scripts/target-matches-native-check.mjs",
    "test:profile-prompt": "node scripts/profile-prompt-native-check.mjs",
    "test:wikipedia-ui": "node scripts/wikipedia-native-check.mjs",
    "test:inquiry-history": "node scripts/inquiry-history-native-check.mjs",
    "test:synopsis": "node scripts/synopsis-native-check.mjs",
    "test:workspace": "node scripts/workspace-native-check.mjs",
    "test:research": "node scripts/research-native-check.mjs",
    "test:native-views": "node scripts/native-views-check.mjs"
  },
  "keywords": [],
  "license": "0-BSD",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cytoscape": "^3.21.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cytoscape": "^3.34.4",
    "cytoscape-elk": "^2.3.0",
    "cytoscape-fcose": "^2.2.0",
    "elkjs": "0.9.3",
    "yaml": "^2.9.1"
  }
}
