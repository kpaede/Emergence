{
  "name": "emergence",
  "version": "0.0.4",
  "description": "Lokaler Multiplex-Wissensgraph und kontrollierte KI-Vorschläge für Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:vault": "node scripts/inspect-vault.mjs",
    "source:export": "node scripts/export-source.mjs",
    "test:obsidian": "node scripts/obsidian-check.mjs",
    "test:ollama": "EMERGENCE_OLLAMA_TEST=1 vitest run tests/ollama.integration.test.ts",
    "test:ux": "node scripts/ux-check.mjs",
    "test:settings-ui": "node scripts/settings-native-check.mjs",
    "test:field-ideas-native": "node scripts/field-ideas-native-check.mjs",
    "test:context": "node scripts/context-check.mjs",
    "test:assignment-ui": "node scripts/assignment-ui-check.mjs",
    "test:analysis-interactions": "node scripts/analysis-interaction-check.mjs",
    "test:models": "node scripts/compare-models.mjs",
    "test:one-click": "node scripts/one-click-native-check.mjs",
    "test:ideas-ui": "node scripts/compact-ideas-ui-check.mjs",
    "test:ideas": "node scripts/association-comparison.mjs",
    "test:zotlit": "node scripts/zotlit-native-check.mjs",
    "test:inline-edit": "node scripts/inline-edit-native-check.mjs",
    "test:target-matches": "node scripts/target-matches-native-check.mjs",
    "test:profile-prompt": "node scripts/profile-prompt-native-check.mjs",
    "test:wikipedia-ui": "node scripts/wikipedia-native-check.mjs",
    "test:synopsis": "node scripts/synopsis-native-check.mjs",
    "test:workspace": "node scripts/workspace-native-check.mjs",
    "test:native-views": "node scripts/native-views-check.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:literature-ui": "node scripts/literature-native-check.mjs",
    "test:literature-scroll": "node scripts/literature-scroll-native-check.mjs",
    "test:term-assignment-ui": "node scripts/term-assignment-native-check.mjs",
    "test:mermaid-ui": "node scripts/mermaid-native-check.mjs",
    "test:mermaid-editing-ui": "node scripts/mermaid-editing-native-check.mjs",
    "test:mermaid-gestures-ui": "node scripts/mermaid-gestures-native-check.mjs",
    "test:mermaid-library-ui": "node scripts/mermaid-library-native-check.mjs",
    "test:argdown-ui": "node scripts/argdown-native-check.mjs",
    "test:argdown-context-ui": "node scripts/argdown-context-native-check.mjs",
    "test:diagram-library-ui": "node scripts/diagram-library-native-check.mjs",
    "test:argdown-presentation-ui": "node scripts/argdown-presentation-native-check.mjs",
    "test:argdown-derivation-ui": "node scripts/argdown-derivation-native-check.mjs",
    "test:argdown-reliability-ui": "node scripts/argdown-reliability-native-check.mjs",
    "test:argdown-selection-ui": "node scripts/argdown-selection-native-check.mjs",
    "test:i18n-ui": "node scripts/i18n-native-check.mjs",
    "test:preferences-ui": "node scripts/preferences-native-check.mjs",
    "test:argdown-direction-ui": "node scripts/argdown-direction-native-check.mjs"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "keywords": [],
  "license": "0-BSD",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^9.39.4",
    "@types/cytoscape": "^3.21.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@argdown/core": "^2.0.1",
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "ajv": "^8.20.0",
    "cytoscape": "^3.34.4",
    "cytoscape-elk": "^2.3.0",
    "cytoscape-fcose": "^2.2.0",
    "elkjs": "0.9.3",
    "i18next": "^27.1.1",
    "yaml": "^2.9.1"
  }
}
